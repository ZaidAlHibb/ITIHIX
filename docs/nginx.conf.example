# Contoh pengaman untuk Nginx (sesuaikan root & fastcgi_pass)
location ~ /\.(?!well-known) { deny all; }
location ~* \.(sql|md|log|bak|ini|sh)$ { deny all; }
location ~ ^/itihix/(migrations|tests|docs|vendor|includes)/ { deny all; }
location ^~ /itihix/uploads/ {
    location ~ \.(php|phtml|phar|php[0-9])$ { deny all; }
}

